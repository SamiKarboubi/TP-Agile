# Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_TIMEOUT_SECONDS=25
ANTHROPIC_MAX_RETRIES=1

# TMDB MCP / upstream APIs
TMDB_API_TOKEN=
OMDB_API_KEY=
TMDB_LANGUAGE=fr-FR
TMDB_REGION=FR
TMDB_MCP_COMMAND=npx
TMDB_MCP_ARGS=["-y","tmdb-mcp@0.11.0"]
MCP_CALL_TIMEOUT_SECONDS=30

# Application
MAX_USER_MESSAGE_LENGTH=200
MAX_RECOMMENDATIONS=7
MOVIE_CANDIDATE_LIMIT=20
DEFAULT_MIN_VOTES=200
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
LOG_LEVEL=INFO
